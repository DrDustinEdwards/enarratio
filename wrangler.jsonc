{
  // The gallery at https://enarratio.dustinedwards.info: an assets-only Worker serving site/dist,
  // which `npm run gallery` builds. No account id here: wrangler takes it from the login or from
  // CLOUDFLARE_ACCOUNT_ID. Deploy with `npm run deploy:gallery`.
  "$schema": "https://unpkg.com/wrangler@4.143.0/config-schema.json",
  // The name matches the Worker's name in the dashboard, where it was renamed from
  // abscissa-gallery (design record 0010) and then from enarratio-gallery, so every family
  // Worker serving a product's site takes the product's name. A name that did not match would
  // deploy a second Worker.
  "name": "enarratio",
  "compatibility_date": "2026-09-28",
  // A minified bundle with its source maps uploaded, so stack traces in the logs still read.
  "minify": true,
  "upload_source_maps": true,
  // A tiny Worker in front of the assets redirects http: to https: and the old hostname to the
  // new one (worker/index.ts).
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // Pages are served at clean addresses (/dustinedwards); /dustinedwards.html redirects there.
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "enarratio.dustinedwards.info", "custom_domain": true }],
  // Workers Logs keep the Worker's own lines, which are the Content-Security-Policy violation
  // reports (worker/index.ts, record 0018). Invocation logs (one per request) stay off: the
  // gallery records nothing about its readers.
  "observability": { "logs": { "enabled": true, "invocation_logs": false } },
  "workers_dev": false,
  "preview_urls": false
}
