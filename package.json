{
  "name": "enarratio",
  "version": "0.4.0",
  "description": "Accessible, server-rendered charts and scientific figures for the web",
  "keywords": [
    "charts",
    "svg",
    "server-side-rendering",
    "accessibility",
    "data-visualization",
    "scientific-figures",
    "observable-plot"
  ],
  "homepage": "https://enarratio.dustinedwards.info",
  "bugs": {
    "url": "https://github.com/DrDustinEdwards/enarratio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DrDustinEdwards/enarratio.git"
  },
  "license": "MIT",
  "author": "Dustin Edwards (https://dustinedwards.info)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base.css": "./dist/base.css",
    "./plot": {
      "types": "./dist/plot/index.d.ts",
      "default": "./dist/plot/index.js"
    },
    "./science": {
      "types": "./dist/science/index.d.ts",
      "default": "./dist/science/index.js"
    },
    "./enhance": {
      "types": "./dist/enhance/index.d.ts",
      "default": "./dist/enhance/index.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "default": "./dist/themes/index.js"
    },
    "./lite": {
      "types": "./dist/lite/index.d.ts",
      "default": "./dist/lite/index.js"
    },
    "./lite/bar": {
      "types": "./dist/lite/bar.d.ts",
      "default": "./dist/lite/bar.js"
    },
    "./lite/line": {
      "types": "./dist/lite/line.d.ts",
      "default": "./dist/lite/line.js"
    },
    "./lite/area": {
      "types": "./dist/lite/area.d.ts",
      "default": "./dist/lite/area.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#document": {
      "node": "./dist/render/document.js",
      "workerd": "./dist/render/document.js",
      "worker": "./dist/render/document.js",
      "edge-light": "./dist/render/document.js",
      "deno": "./dist/render/document.js",
      "browser": "./dist/render/document.browser.js",
      "default": "./dist/render/document.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build-css.mjs && node scripts/bundle-enhance.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm run lint && npm test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "gallery": "node scripts/gallery.ts",
    "deploy:gallery": "npm run build && npm run gallery && npx --yes wrangler@4.143.0 deploy",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "prepare": "npm run build",
    "size": "node scripts/size-check.mjs",
    "bloat": "devkit-no-bloat --warn-only"
  },
  "peerDependencies": {
    "@observablehq/plot": "0.6.17",
    "d3-force": "3.0.0",
    "linkedom": "0.18.14"
  },
  "peerDependenciesMeta": {
    "@observablehq/plot": {
      "optional": true
    },
    "d3-force": {
      "optional": true
    },
    "linkedom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@drdustinedwards/site-helpers": "github:DrDustinEdwards/prelum#v0.17.0",
    "@dustinedwards/devkit": "github:DrDustinEdwards/devkit#v0.20.2",
    "@dustinedwards/site-runtime": "github:DrDustinEdwards/site-runtime#v0.29.0",
    "@observablehq/plot": "0.6.17",
    "@types/d3-force": "3.0.10",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "@vitest/coverage-v8": "4.1.12",
    "axe-core": "4.14.0",
    "capsomer": "github:DrDustinEdwards/capsomer#v0.44.2",
    "d3-force": "3.0.0",
    "linkedom": "0.18.14",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "puppeteer": "25.16.0",
    "rolldown": "1.2.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
