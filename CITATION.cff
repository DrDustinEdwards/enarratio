    given-names: Dustin
    orcid: "https://orcid.org/0000-0001-6409-8041"
    affiliation: "Tarleton State University"
repository-code: "https://github.com/DrDustinEdwards/enarratio"
url: "https://enarratio.dustinedwards.info"
license: MIT
version: 0.2.0
date-released: "2026-10-02"
keywords:
  - data visualization
  - accessibility
  - server-side rendering
  - scientific figures
  - virology
  - TypeScript
